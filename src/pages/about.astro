---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import CostContent from "../components/CostContent.astro";
import { SITE } from "../config/site.mjs";

// The story on a time axis, from now back to the start. `years` is the time that
// passes until the next entry down, which is the one before it in time, and it
// sets the space below the entry, so the gaps on the page are proportional to
// the gaps in time. "Then" has no year: it happened in between.
const timeline = [
  { date: "Now", text: 'A third floor with a rooftop terrace, nine years in.', node: "bg-dandelion", years: 2 },
  { date: "2024", text: 'The demolition that threatened the house is cancelled. It stays.', node: "bg-dandelion", years: 2 },
  { date: "2022", text: 'Franco Ruiz takes care of the house.', node: "bg-lavender-300", years: 2 },
  { date: "Then", text: 'It moves to Sants, a working-class, cooperative neighbourhood, and stays.', node: "bg-lavender-300", years: 1.2 },
  { date: "2017", text: 'The first house opens near the Sagrada Família. The neighbours think it is an illegal Airbnb.', node: "bg-dandelion", years: 0.4 },
  {
    date: "2017",
    big: "$5–6k = 4 months",
    text: 'A week at the Berlin retreat cost $5–6k. In Barcelona, that rents a house for four months.',
    node: "bg-tulip",
    years: 1,
  },
  { date: "2016", text: 'Giveth is founded by altruists from the early Ethereum ecosystem.', node: "bg-aquamarine", years: 0 },
] as const;

// Each value is a tile with the word on top and its short explanation at the bottom.
const values = [
  { word: "Openness", note: "Freedom of thought", style: "bg-dandelion text-ink" },
  { word: "Cooperation", note: "Camaraderie, no hierarchy", style: "bg-lavender-300 text-ink" },
  { word: "Regenerative economics", note: "Built around public goods", style: "bg-white text-ink" },
  { word: "Solarpunk optimism", note: "Building better systems together", style: "bg-grape text-white" },
];

---

<Layout
  title={`About | ${SITE.title}`}
  description="Giveth House is the physical home of the Giveth Galaxy, a community home in Barcelona open to builders, contributors, and communities since 2017."
  canonicalURL={`${SITE.url}/about`}
>
  <Header />
  <main id="main-content" role="main">
    <!-- The opening is a yellow band (the colour of the house) across the whole width, with no border -->
    <Section tone="dandelion" pad="lg" wall={false} aria-labelledby="about-heading">
      <ScrollReveal client:load>
        <h1 id="about-heading" class="display-title text-ink leading-[0.95] mb-6">Giveth House</h1>
        <p class="text-xl md:text-2xl text-ink max-w-2xl">
          A home in Barcelona where Web3 builders and communities live, work and try things together.
          Barcelona for its freedom of thought and choice, Sants for its workers' movements and cooperative culture.
        </p>
      </ScrollReveal>
    </Section>

    <Section tone="white" pad="md-tight" wall={false} aria-labelledby="story-heading">
      <ScrollReveal client:idle>
        <h2 id="story-heading" class="display-title text-ink leading-[0.95] mb-5 md:mb-6">How it began</h2>
      </ScrollReveal>
      <!-- The colour key: the same four colours as the rotating word of the home -->
      <ul role="list" class="flex flex-wrap gap-x-6 gap-y-2 mb-8 md:mb-10 text-sm md:text-base font-semibold text-ink">
        <li class="flex items-center gap-2"><span class="inline-block w-4 h-4 border-[3px] border-ink bg-dandelion" aria-hidden="true"></span>house</li>
        <li class="flex items-center gap-2"><span class="inline-block w-4 h-4 border-[3px] border-ink bg-lavender-300" aria-hidden="true"></span>community</li>
        <li class="flex items-center gap-2"><span class="inline-block w-4 h-4 border-[3px] border-ink bg-aquamarine" aria-hidden="true"></span>projects</li>
        <li class="flex items-center gap-2"><span class="inline-block w-4 h-4 border-[3px] border-ink bg-tulip" aria-hidden="true"></span>economy</li>
      </ul>
      <!--
        An axis: one thick ink line, a square on it for every milestone, the date
        to its left and the text to its right. The space between entries follows
        the time between them.
      -->
      <ol role="list" class="timeline">
        {timeline.map((t, i) => (
          <li class="timeline-item" style={`--years: ${t.years};`}>
            <ScrollReveal client:idle delay={0.05} direction="right" distance={30}>
              <div class="timeline-row">
                <span class="timeline-date font-display font-extrabold leading-none">{t.date}</span>
                <span class:list={["timeline-node", t.node]} aria-hidden="true"></span>
                <div class="timeline-text">
                  {"big" in t && (
                    <p class="inline-block bg-tulip border-[length:var(--stroke)] border-ink font-display font-bold leading-none px-3 py-2 mb-3" style="font-size: clamp(1.5rem, 3.4vw, 3rem);">{t.big}</p>
                  )}
                  <p class="text-lg md:text-2xl leading-snug max-w-2xl">{t.text}</p>
                </div>
              </div>
            </ScrollReveal>
          </li>
        ))}
      </ol>
    </Section>

    <!--
      One blue block that holds the values and the cost. The four values are tiles
      inside it, so no value is ever the "same colour as the block below": they are
      part of it.
    -->
    <Section tone="white" pad="md-tight-flush" wall={false} aria-labelledby="values-heading">
      <div data-dark class="bg-ink text-white">
        <div class="px-6 pt-10 md:px-12 md:pt-14">
          <ScrollReveal client:idle>
            <h2 id="values-heading" class="display-title text-white leading-[0.95] mb-8 md:mb-10">Values</h2>
          </ScrollReveal>
        </div>
        <div class="quad">
          {values.map((v, i) => (
            <ScrollReveal client:idle className="quad-item" delay={i * 0.08} direction="up" distance={40}>
              <div
                data-dark={v.style.includes("text-white") ? true : undefined}
                class:list={["w-full h-full p-4 md:p-6 flex flex-col justify-between gap-3", v.style]}
              >
                <p class="font-display font-bold leading-[1.02]" style="font-size: clamp(1.5rem, 2.6vw, 2.5rem);">{v.word}</p>
                <p class="text-[13px] md:text-[15px] leading-snug">{v.note}</p>
              </div>
            </ScrollReveal>
          ))}
        </div>
        <div class="px-6 pt-12 pb-12 md:px-12 md:pt-16 md:pb-20">
          <CostContent accent="tulip" />
        </div>
      </div>
    </Section>
  </main>
  <Footer block />
</Layout>
