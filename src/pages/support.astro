---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import Button from "../components/Button.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../config/site.mjs";

// Six blocks, each one a way to help. Money is one of them, not the headline.
// Colours follow the themes of the home: house is dandelion, community is
// lavender, projects is sky blue, economy is pink. Ink text on all of them
// passes the contrast: the titles are large bold text.
const ways = [
  {
    id: "spread-the-word",
    icon: "tabler:speakerphone",
    colour: "bg-lavender-300",
    title: "Spread the word",
    text: "Tell builders in your network about the house, and send us a few lines about your stay.",
    button: { label: "Send a testimonial" },
  },
  {
    id: "host",
    icon: "tabler:presentation",
    colour: "bg-aquamarine",
    title: "Host something",
    text: "A talk, a workshop, a dinner or a small hacker house. Tell us your idea.",
    button: { label: "Write to us" },
  },
  {
    id: "community-supporter",
    icon: "tabler:heart-handshake",
    colour: "bg-dandelion",
    title: "Become a Community Supporter",
    text: "For regular guests who want to support the house in a more structured way.",
    button: { label: "Get in touch" },
  },
  {
    id: "bring",
    icon: "tabler:gift",
    colour: "bg-tulip",
    title: "Bring something",
    text: "Coffee, snacks and pantry basics are always welcome. Just bring them.",
    // Ink on pink is 4.19:1, so the text of the pink block is large (24px) to pass
    large: true,
  },
] as const;
---

<Layout
  title={`Support | ${SITE.title}`}
  description="Support Giveth House, a solarpunk home for the blockchain4good community in Barcelona. Your donations keep the doors open."
  canonicalURL={`${SITE.url}/support`}
>
  <Header />
  <main id="main-content" role="main">
    <Section tone="white" pad="lg" wall={false} aria-labelledby="support-heading">
      <ScrollReveal client:load>
        <h1 id="support-heading" class="display-title text-ink leading-[0.95] mb-6">Support Giveth House</h1>
        <p class="text-xl md:text-2xl text-ink max-w-2xl">
          The house runs on community generosity. Money is one way to give, and not the only one.
        </p>
      </ScrollReveal>
    </Section>

    <Section tone="white" pad="none" wall={false}>
      <!-- Blocks of equal width sharing one wall, same grammar as the offers of the home -->
      <div id="other-ways" role="list" class="duo duo-auto scroll-mt-24">
        {ways.map((way, i) => (
          <ScrollReveal client:idle className="duo-item" delay={i * 0.1} direction="up" distance={40}>
            <div
              id={way.id}
              role="listitem"
              class:list={["w-full h-full p-6 md:p-8 flex flex-col justify-between gap-8 text-ink scroll-mt-24", way.colour]}
            >
              <div>
                <Icon name={way.icon} class="w-10 h-10 md:w-12 md:h-12 mb-5" aria-hidden="true" />
                <h2 class="font-display font-bold leading-[1.02] mb-4" style="font-size: clamp(2rem, 3.4vw, 3.25rem);">
                  {way.title}
                </h2>
                <p class:list={["max-w-md", "large" in way ? "text-2xl leading-snug" : "text-[17px]"]}>{way.text}</p>
              </div>
              {"button" in way && (
                <div>
                  <Button href={SITE.houseTelegram} size="lg" class="whitespace-nowrap">
                    {way.button.label}
                  </Button>
                </div>
              )}
            </div>
          </ScrollReveal>
        ))}
      </div>
    </Section>
  </main>
  <Footer block />
</Layout>
