---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";

const steps = [
  {
    title: "Open our project on Giveth",
    body: "Go to the Giveth House project page. It's the only place we collect donations.",
    link: { href: SITE.givethDonation, label: "giveth.io/project/giveth-house" },
  },
  {
    title: "Click Donate and connect your wallet",
    body: "You can give in almost any token, on most major chains.",
  },
  {
    title: "Choose the amount and confirm",
    body: "That's it. Thank you!",
  },
];
import Button from "../components/Button.astro";
import Card from "../components/Card.astro";
---

<Layout
  title={`Donate | ${SITE.title}`}
  description="How to support Giveth House in three steps: no prices, no tickets, just contributions from the people who stay, cowork and gather here."
  canonicalURL={`${SITE.url}/donate`}
>
  <Header />
  <main id="main-content" role="main">
    <section class="max-w-4xl mx-auto px-4 py-12 md:py-20">

      <ScrollReveal client:idle>
        <h1 class="text-4xl md:text-5xl font-extrabold text-ink mb-4">Keep the house open</h1>
      </ScrollReveal>

      <ScrollReveal client:load delay={0.1}>
        <p class="text-xl text-ink-muted mb-6 max-w-2xl">
          Giveth House has no fixed prices and no membership fees. It runs on contributions from the people who stay, cowork and gather here. Donations pay for rent, utilities and maintenance.
        </p>
        <p class="text-ink-muted mb-12 max-w-2xl">
          Contribute whatever feels right for your stay. There's no minimum and no expected amount.
        </p>
      </ScrollReveal>

      <ScrollReveal client:load delay={0.15}>
        <h2 class="text-2xl font-bold text-ink mb-6">How to donate in 3 steps</h2>
      </ScrollReveal>

      <div class="space-y-4 mb-12">
        {steps.map((step, i) => (
          <ScrollReveal client:load delay={0.2 + i * 0.05}>
            <div class="flex gap-4 items-start">
              <div class="w-8 h-8 rounded-full bg-ink text-white flex items-center justify-center text-sm font-bold shrink-0 mt-0.5">{i + 1}</div>
              <div>
                <h3 class="font-semibold text-ink mb-1">{step.title}</h3>
                <p class="text-ink-muted text-sm">
                  {step.body}
                  {step.link && (
                    <>
                      {" "}
                      <a
                        href={step.link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="underline hover:text-grape-dark text-grape"
                      >{step.link.label}</a>
                    </>
                  )}
                </p>
              </div>
            </div>
          </ScrollReveal>
        ))}
      </div>

      <ScrollReveal client:load delay={0.4}>
        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <Button href={SITE.givethDonation} size="lg">
            Donate on Giveth
          </Button>
        </div>
      </ScrollReveal>

      <ScrollReveal client:load delay={0.45}>
        <Card tone="bone" class="mb-12">
          <h2 class="text-lg font-semibold text-ink mb-2">New to crypto, or something not working?</h2>
          <p class="text-ink-muted">
            If the Giveth page gives you an error or you're not sure how to do it, write to us on
            Telegram at
            <a
              href={SITE.houseTelegram}
              target="_blank"
              rel="noopener noreferrer"
              class="underline hover:text-grape-dark text-grape"
            >{SITE.houseHandle}</a>
            and we'll sort it out together.
          </p>
        </Card>
      </ScrollReveal>

      <ScrollReveal client:load delay={0.5}>
        <p class="text-ink-muted text-sm">
          There are other ways to help too.
          <a href="/support#other-ways" class="underline hover:text-grape-dark text-grape">See other ways to support the house</a>.
        </p>
      </ScrollReveal>

    </section>
  </main>
  <Footer />
</Layout>
