---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import Button from "../components/Button.astro";
import { SITE } from "../config/site.mjs";

// The same colours as the steps of How it Works on the home
const stepColours = ["bg-dandelion", "bg-lavender-300", "bg-aquamarine"];

const steps = [
  {
    title: "Open our project on Giveth",
    body: "It's the only place we collect donations.",
    link: { href: SITE.givethDonation, label: "giveth.io/project/giveth-house" },
  },
  {
    title: "Click Donate and connect your wallet",
    body: "You can give in almost any token, on most major chains.",
  },
  {
    title: "Choose the amount and confirm",
    body: "That's it. Thank you!",
  },
];
---

<Layout
  title={`Donate | ${SITE.title}`}
  description="How to support Giveth House in three steps: no prices, no tickets, just contributions from the people who stay, cowork and gather here."
  canonicalURL={`${SITE.url}/donate`}
>
  <Header />
  <main id="main-content" role="main">
    <Section tone="white" pad="lg" wall={false} aria-labelledby="donate-heading">
      <ScrollReveal client:load>
        <h1 id="donate-heading" class="display-title text-ink leading-[0.95] mb-6">Keep the house open</h1>
        <p class="text-xl md:text-2xl text-ink max-w-2xl">
          Contribute whatever feels right. There's no minimum and no expected amount.
        </p>
      </ScrollReveal>
    </Section>

    <Section tone="white" pad="none" wall={false}>
      <!-- Three steps, on the same column lines as the photos of the home and the steps of How it Works -->
      <div class="grid cols-photo-grid gap-8">
        {steps.map((step, i) => (
          <ScrollReveal client:load delay={0.1 + i * 0.1} scale={true}>
            <div class="md:pr-8">
              <div class:list={["w-12 h-12 text-ink border-[length:var(--stroke)] border-ink flex items-center justify-center text-xl font-bold mb-4", stepColours[i]]}>{i + 1}</div>
              <h2 class="text-xl font-semibold text-ink mb-2">{step.title}</h2>
              <p class="text-ink-muted text-sm">
                {step.body}
                {step.link && (
                  <>
                    {" "}
                    <a
                      href={step.link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline hover:text-grape-dark text-grape"
                    >{step.link.label}</a>
                  </>
                )}
              </p>
            </div>
          </ScrollReveal>
        ))}
      </div>

      <ScrollReveal client:load delay={0.4}>
        <div class="mt-10 md:mt-12 mb-10 md:mb-14 flex flex-wrap gap-4">
          <Button href={SITE.givethDonation} size="lg" class="whitespace-nowrap">Donate on Giveth</Button>
          <Button href="/support#other-ways" variant="secondary" size="lg" class="whitespace-nowrap">
            Other ways to help
          </Button>
        </div>
      </ScrollReveal>

      <!-- Pink is the colour of the economy. This block sits right above the footer block, same width -->
      <ScrollReveal client:load delay={0.45}>
        <div class="bg-tulip text-ink border-[length:var(--stroke)] border-ink px-6 py-8 md:px-12 md:py-12">
          <h2 class="font-display font-bold leading-tight mb-4" style="font-size: clamp(1.75rem, 3.4vw, 3rem);">
            New to crypto, or something not working?
          </h2>
          <p class="text-2xl leading-snug max-w-3xl">
            Write to us on Telegram at
            <a href={SITE.houseTelegram} target="_blank" rel="noopener noreferrer" class="underline">{SITE.houseHandle}</a>
            and we'll sort it out together.
          </p>
        </div>
      </ScrollReveal>
    </Section>
  </main>
  <Footer block />
</Layout>
