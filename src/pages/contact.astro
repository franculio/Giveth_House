---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
---

<Layout
  title={`Contact | ${SITE.title}`}
  description="Get in touch with Giveth House Barcelona. Message the house on Telegram to ask about a stay, a coworking day or an event."
  canonicalURL={`${SITE.url}/contact`}
>
  <Header />
  <main id="main-content" role="main">
    <section class="max-w-2xl mx-auto px-4 py-12 md:py-20">

      <ScrollReveal client:idle>
        <h1 class="text-4xl md:text-5xl font-extrabold text-ink mb-4">Get in Touch</h1>
      </ScrollReveal>

      <ScrollReveal client:idle delay={0.1}>
        <p class="text-xl text-ink-muted mb-12">
          The best way to connect with Giveth House is through Telegram.
          Write to the house account for anything: a stay, a coworking day, a visit or an event.
        </p>
      </ScrollReveal>

      <div class="space-y-4">
        <ScrollReveal client:idle delay={0.2}>
          <div class="bg-white rounded-xl border border-athens p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <h2 class="text-lg font-semibold text-ink mb-1">Message the house</h2>
              <p class="text-ink-muted text-sm">
                Stays, coworking, visits, collaborations, or just saying hi.
                If you're asking about a stay, tell us who you are, your dates and what brings you to Barcelona.
              </p>
            </div>
            <a
              href={SITE.houseTelegram}
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 inline-flex items-center justify-center px-6 py-2.5 bg-grape text-white rounded-lg hover:bg-grape-dark transition-colors font-medium text-sm"
            >
              {SITE.houseHandle}
            </a>
          </div>
        </ScrollReveal>

        <ScrollReveal client:idle delay={0.3}>
          <div class="bg-white rounded-xl border border-athens p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <h2 class="text-lg font-semibold text-ink mb-1">Follow on X</h2>
              <p class="text-ink-muted text-sm">
                Updates, community moments, and announcements from Giveth House.
              </p>
            </div>
            <a
              href="https://x.com/GivethHouse"
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 inline-flex items-center justify-center px-6 py-2.5 bg-white text-ink border-2 border-ink rounded-lg hover:bg-ink transition-colors font-medium text-sm hover:text-white"
            >
              @GivethHouse
            </a>
          </div>
        </ScrollReveal>
      </div>

    </section>
  </main>
  <Footer />
</Layout>
