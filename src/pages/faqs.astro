---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
import ScrollReveal from "../components/ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";

// The questions come in four groups, one per theme, in the same order and with
// the same colours as the rotating word of the home: house is dandelion,
// community is lavender, projects is sky blue, economy is pink. Ink text on all
// of them passes the contrast: the question is large bold text, which only
// needs 3:1 on pink.
const groups = [
  {
    title: "House",
    colour: "bg-dandelion",
    faqs: [
      {
        question: "What is Giveth House?",
        answer:
          "A community home in Barcelona's Sants neighbourhood where builders and communities from the Web3 and ReFi ecosystem live, cowork and meet. Open since 2017.",
      },
      {
        question: "Who gets priority for a stay?",
        answer:
          "Stays are for contributors passing through Barcelona or attending events. Priority goes to people connected to Giveth, Web3 or ReFi.",
      },
      {
        question: "How does arriving work?",
        answer:
          "There is no self-entry, so you coordinate your arrival with Franco once you're approved. We share the exact address once your stay is confirmed.",
      },
    ],
  },
  {
    title: "Community",
    colour: "bg-lavender-300",
    faqs: [
      {
        question: "Who is it for?",
        answer:
          "Open source contributors, DAO builders and Web3 communities visiting Barcelona. The door is open to anyone who shares the values of the space: curiosity, collaboration and building better systems.",
      },
      {
        question: "What if I don't have a community vouch?",
        answer:
          "A vouch helps, but it isn't required. Share a little about what you're working on and Franco will consider your request.",
      },
      {
        question: "Can I just visit for a short time?",
        answer:
          "Yes. Short visits to meet the community or join a gathering are welcome, for anyone who shares the values of the space. Message us on Telegram to arrange it.",
      },
    ],
  },
  {
    title: "Projects",
    colour: "bg-aquamarine",
    faqs: [
      {
        question: "How do I apply for a stay, coworking day, or visit?",
        answer:
          "Write to @Giveth_House on Telegram: who you are, your dates, what brings you to Barcelona and your connection to Giveth, Web3 or ReFi. Franco replies personally.",
      },
      {
        question: "Can I host an event?",
        answer:
          "Yes. Talks, workshops, hacker houses, dinners and meetups. The basement and common areas suit small gatherings. Write to us on Telegram.",
      },
    ],
  },
  {
    title: "Economy",
    colour: "bg-tulip",
    faqs: [
      {
        question: "How much does it cost to stay?",
        answer:
          "There is no fixed price. Guests contribute what feels right after their stay, in almost any crypto token. The house runs on that generosity.",
      },
      {
        question: "How is Giveth House funded?",
        answer:
          "By community donations on the Giveth platform. They cover rent, utilities, maintenance and operations, so the space stays open to the Web3 ecosystem.",
      },
    ],
  },
] as const;
---

<Layout
  title={`FAQs | ${SITE.title}`}
  description="Frequently asked questions about Giveth House: who it's for, how stays work, events, and how the house is funded."
  canonicalURL={`${SITE.url}/faqs`}
>
  <Header />
  <main id="main-content" role="main">
    <Section tone="white" pad="lg" wall={false} aria-labelledby="faq-heading">
      <ScrollReveal client:load>
        <h1 id="faq-heading" class="display-title text-ink leading-[0.95] mb-6">FAQs</h1>
        <p class="text-xl md:text-2xl text-ink max-w-2xl">
          Who the house is for, how a stay works, events and how it is funded.
        </p>
      </ScrollReveal>
    </Section>

    <Section tone="white" pad="bottom-lg" wall={false}>
      <div class="grid gap-12 md:gap-16">
        {groups.map((group, g) => (
          <ScrollReveal client:load delay={0.05 + g * 0.05}>
            <section aria-labelledby={`faq-group-${g}`}>
              <!-- No visible label: the colour tells the groups apart. The name stays for screen readers -->
              <h2 id={`faq-group-${g}`} class="sr-only">{group.title}</h2>
              <!-- The questions of a group are blocks stacked and sharing one wall -->
              <div role="list">
                {group.faqs.map((faq, i) => (
                  <details
                    role="listitem"
                    class:list={[
                      "faq group border-[length:var(--stroke)] border-ink bg-white",
                      i > 0 && "-mt-[var(--stroke)]",
                    ]}
                  >
                    <summary
                      class:list={[
                        "flex items-center gap-4 list-none cursor-pointer px-4 py-4 md:px-6 md:py-5 text-left text-ink hover:brightness-95 transition",
                        group.colour,
                      ]}
                    >
                      <span class="font-display font-bold text-xl md:text-3xl leading-tight flex-1">{faq.question}</span>
                      <span
                        class="shrink-0 w-6 h-6 flex items-center justify-center group-open:rotate-180 transition-transform"
                        aria-hidden="true"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square">
                          <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                      </span>
                    </summary>
                    <div class="px-4 py-5 md:px-6 md:py-6 bg-white text-ink">
                      <p class="text-lg md:text-xl max-w-2xl">{faq.answer}</p>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          </ScrollReveal>
        ))}
      </div>
    </Section>
  </main>
  <Footer />
</Layout>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>
