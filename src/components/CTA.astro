---
import ScrollReveal from "./ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
import Button from "./Button.astro";
import Section from "./Section.astro";
---

<Section tone="grape" pad="lg" wall={false} id="about">
  <ScrollReveal client:idle>
    <div>
      <h2 class="display-title leading-[0.95] mb-6">Ready to visit?</h2>
      <p class="text-lg md:text-xl text-botticelli mb-8 max-w-2xl">
        Write to us on Telegram about a stay, coworking day, or event. Franco reviews every
        request personally.
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <Button href={SITE.houseTelegram} variant="on-dark" size="lg">
          Write to us on Telegram
        </Button>
        <Button href="/support" variant="on-dark-outline" size="lg">
          Support the House
        </Button>
      </div>
    </div>
  </ScrollReveal>
</Section>
