---
import ScrollReveal from "./ScrollReveal.tsx";
import { testimonials, TESTIMONIALS_VISIBLE } from "../data/testimonials";

// Before the script runs (or without JS) only the first N cards show.
const fallbackCss = `[data-testimonials]:not([data-ready]) > astro-island:nth-child(n+${TESTIMONIALS_VISIBLE + 1}) { display: none; }`;
import Card from "./Card.astro";
---

<style is:inline set:html={fallbackCss}></style>

<section class="max-w-6xl mx-auto px-4 py-12 md:py-20">
  <ScrollReveal client:idle delay={0.1}>
    <h2 class="text-3xl md:text-4xl font-bold text-ink text-center mb-4">
      What people say
    </h2>
    <p class="text-center text-ink-muted mb-12 max-w-xl mx-auto">
      From the people who've been here.
    </p>
  </ScrollReveal>

  <div
    data-testimonials
    data-max={TESTIMONIALS_VISIBLE}
    class="grid md:grid-cols-2 gap-6 md:[&>*:last-child:nth-child(odd)>*]:col-span-2"
  >
    {testimonials.map((t, i) => (
      <ScrollReveal client:idle delay={0.15 + (i % TESTIMONIALS_VISIBLE) * 0.1}>
        <Card as="figure" class="h-full flex flex-col justify-between">
          <blockquote class="text-ink text-base leading-relaxed mb-6">
            <span class="text-3xl text-lavender font-serif leading-none select-none" aria-hidden="true">&ldquo;</span>{t.quote}<span class="text-3xl text-lavender font-serif leading-none select-none" aria-hidden="true">&rdquo;</span>
          </blockquote>
          <figcaption>
            <p class="font-semibold text-ink text-sm">{t.name}</p>
            <p class="text-ink-muted text-xs mt-0.5">{t.role}</p>
          </figcaption>
        </Card>
      </ScrollReveal>
    ))}
  </div>
</section>

<script>
  const grid = document.querySelector<HTMLElement>("[data-testimonials]");
  if (grid) {
    const max = Number(grid.dataset.max) || 4;
    const cards = Array.from(grid.children);
    for (let i = cards.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [cards[i], cards[j]] = [cards[j], cards[i]];
    }
    cards.slice(max).forEach((card) => card.remove());
    cards.slice(0, max).forEach((card) => grid.appendChild(card));
    grid.dataset.ready = "true";
  }
</script>
