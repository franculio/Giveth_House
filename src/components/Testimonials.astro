---
import Section from "./Section.astro";
import ScrollReveal from "./ScrollReveal.tsx";
import { testimonials, TESTIMONIALS_VISIBLE } from "../data/testimonials";

// Before the script runs (or without JS) only the first N cards show.
const fallbackCss = `[data-testimonials]:not([data-ready]) > astro-island:nth-child(n+${TESTIMONIALS_VISIBLE + 1}) { display: none; }`;
---

<style is:inline set:html={fallbackCss}></style>

<Section tone="lavender" wall={false}>
  <ScrollReveal client:idle delay={0.1}>
    <h2 class="display-title text-ink leading-[0.95] mb-8 md:mb-10">
      What people say
    </h2>
  </ScrollReveal>

  <!--
    Each card is as tall as its quote needs. When the script runs it shuffles the cards,
    shares them between two columns so the columns come out about the same height, and the
    last card of each column takes whatever is left, so both columns end on the same line.
    A flat colour and the thick ink wall, like the rest of the blocks.
  -->
  <div
    data-testimonials
    data-max={TESTIMONIALS_VISIBLE}
    class="grid md:grid-cols-2 gap-4 md:gap-6"
  >
    {testimonials.map((t, i) => (
      <ScrollReveal client:idle className="flex flex-col" delay={0.15 + (i % TESTIMONIALS_VISIBLE) * 0.1}>
        <figure class="testimonial-card flex-1 flex flex-col justify-between border-[length:var(--stroke)] border-ink bg-white text-ink p-6 md:p-8">
          <blockquote class="text-ink text-[17px] leading-relaxed mb-6" data-quote>
            <span class="text-3xl font-serif leading-none select-none" aria-hidden="true">&ldquo;</span>{t.quote}<span class="text-3xl font-serif leading-none select-none" aria-hidden="true">&rdquo;</span>
          </blockquote>
          <figcaption>
            <p class="font-semibold text-ink text-base">{t.name}</p>
            <p class="text-ink text-sm mt-0.5">{t.role}</p>
          </figcaption>
        </figure>
      </ScrollReveal>
    ))}
  </div>
</Section>

<style is:global>
  /* Four cards, four different colours: dandelion, sky blue, white and violet. Ink text
     passes the contrast on the first three, white text on the violet one.
     Without the script the cards go by their order in the page. */
  [data-testimonials]:not([data-ready]) > :nth-child(4n + 1) .testimonial-card,
  .testimonial-card[data-tone="0"] {
    background-color: var(--color-dandelion);
  }
  [data-testimonials]:not([data-ready]) > :nth-child(4n + 2) .testimonial-card,
  .testimonial-card[data-tone="1"] {
    background-color: var(--color-aquamarine);
  }
  [data-testimonials]:not([data-ready]) > :nth-child(4n + 3) .testimonial-card,
  .testimonial-card[data-tone="2"] {
    background-color: #fff;
  }
  [data-testimonials]:not([data-ready]) > :nth-child(4n + 4) .testimonial-card,
  .testimonial-card[data-tone="3"] {
    background-color: var(--color-grape);
  }
  [data-testimonials]:not([data-ready]) > :nth-child(4n + 4) .testimonial-card,
  [data-testimonials]:not([data-ready]) > :nth-child(4n + 4) .testimonial-card *,
  .testimonial-card[data-tone="3"],
  .testimonial-card[data-tone="3"] * {
    color: #fff;
  }
  /* The last card of each column fills the space left in it */
  /* (the card is wrapped in an island, which has no box of its own, so the rule is for what is inside it) */
  .testimonial-col > :last-child > * {
    flex: 1 1 auto;
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>("[data-testimonials]");
  if (grid) {
    const max = Number(grid.dataset.max) || 4;
    const cards = Array.from(grid.children) as HTMLElement[];

    // Shuffle, keep the first few and drop the rest
    for (let i = cards.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [cards[i], cards[j]] = [cards[j], cards[i]];
    }
    cards.slice(max).forEach((card) => card.remove());
    const chosen = cards.slice(0, max);

    // Share them out so both columns come out about the same height: the longest quote goes
    // with the shortest in one column, the two in the middle in the other (a snake order)
    const length = (card: HTMLElement) => card.querySelector("[data-quote]")?.textContent?.length ?? 0;
    const byLength = [...chosen].sort((a, b) => length(b) - length(a));
    const columns: HTMLElement[][] = [[], []];
    byLength.forEach((card, i) => columns[i % 4 === 0 || i % 4 === 3 ? 0 : 1].push(card));

    grid.replaceChildren();
    let position = 0;
    columns.forEach((list) => {
      const col = document.createElement("div");
      col.className = "testimonial-col flex flex-col gap-4 md:gap-6";
      list.forEach((card) => {
        // The colours go by place in the page, not by quote
        card.querySelector<HTMLElement>(".testimonial-card")?.setAttribute("data-tone", String(position++ % 4));
        col.appendChild(card);
      });
      grid.appendChild(col);
    });
    grid.dataset.ready = "true";
  }
</script>
