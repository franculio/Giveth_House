---
import ScrollReveal from "./ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
---

<section class="max-w-6xl mx-auto px-4 py-14 md:py-32 text-center" aria-labelledby="hero-heading">
  <ScrollReveal client:load>
    <h1 id="hero-heading" class="text-4xl md:text-6xl font-extrabold text-ink mb-6">
      A House for Web3 Builders and Communities
    </h1>
  </ScrollReveal>
  <ScrollReveal client:load delay={0.2}>
    <p class="text-xl md:text-2xl text-ink-muted mb-8 max-w-2xl mx-auto">
      The physical home of the Giveth Galaxy, in Barcelona's Sants neighbourhood. A place to stay, cowork and meet for the blockchain4good community, open since 2017.
    </p>
  </ScrollReveal>
  <ScrollReveal client:load delay={0.4}>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={SITE.houseTelegram}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-8 py-3 bg-grape text-white rounded-lg hover:bg-grape-dark transition-colors font-medium"
        aria-label="Write to us on Telegram"
      >
        Write to us on Telegram
      </a>
      <a
        href="/visit"
        class="inline-flex items-center justify-center px-8 py-3 bg-white text-ink border-2 border-ink rounded-lg hover:bg-ink transition-colors font-medium hover:text-white"
      >
        How it Works
      </a>
    </div>
  </ScrollReveal>
</section>
