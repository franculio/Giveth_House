---
import ScrollReveal from "./ScrollReveal.tsx";
import RotatingWord from "./RotatingWord.tsx";
import { SITE } from "../config/site.mjs";
import Button from "./Button.astro";
---

<section class="max-w-7xl mx-auto px-4 pt-10 pb-8 md:pt-16 md:pb-8 overflow-x-clip" aria-labelledby="hero-heading">
  <!-- Oversized, tight headline across the full width, like the composition references -->
  <ScrollReveal client:load>
    <h1
      id="hero-heading"
      class="display-title text-ink"
      style="line-height: 0.88;"
    >
      Every visit <span data-align-target class="inline-block border-[0.08em] border-ink px-[0.14em] mx-[0.03em]" style="line-height: 0.95;">adds</span><br /><span aria-hidden="true">to the </span><RotatingWord client:load words={[{ text: "house", color: "dandelion" }, { text: "community", color: "lavender-300" }, { text: "projects", color: "aquamarine" }, { text: "economy", color: "tulip", alignRight: true }]} /><span aria-hidden="true">.</span><span class="sr-only"> to the house, the community, the projects and the economy.</span>
    </h1>
  </ScrollReveal>

  <ScrollReveal client:load delay={0.2}>
    <div class="mt-10 md:mt-14 max-w-2xl">
      <p class="text-xl md:text-2xl text-ink mb-8">
        Giveth House is a home in Barcelona for people building in Ethereum, ReFi and public goods. You bring what you have, the house brings a place to share it, and the gift keeps moving.
      </p>
      <div class="flex flex-wrap gap-4">
        <Button href="/donate" size="lg" class="whitespace-nowrap">Contribute to the house</Button>
        <Button href={SITE.houseTelegram} variant="secondary" size="lg" class="whitespace-nowrap">
          Come and stay
        </Button>
      </div>
    </div>
  </ScrollReveal>
</section>
