---
import ScrollReveal from "./ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
import Card from "./Card.astro";
---

<section id="features" class="max-w-6xl mx-auto px-4 py-12 md:py-20">
  <ScrollReveal client:idle delay={0.1}>
    <h2 class="text-4xl font-bold text-ink text-center mb-4">What happens here</h2>
    <p class="text-center text-ink-muted mb-12 max-w-xl mx-auto">
      A home, a workspace and a place to meet.
    </p>
  </ScrollReveal>
  <div class="grid md:grid-cols-2 gap-8">
    <ScrollReveal client:idle delay={0.2} scale={true}>
      <Card class="h-full hover:shadow-lg transition-shadow">
        <div class="w-12 h-12 bg-athens rounded-lg flex items-center justify-center mb-4">
          <Icon name="tabler:home" class="w-6 h-6 text-ink" aria-hidden="true" />
        </div>
        <h3 class="text-xl font-semibold text-ink mb-2">Stay</h3>
        <p class="text-ink-muted">
          A place to sleep for contributors visiting Barcelona. A home, not a hotel.
        </p>
      </Card>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.3} scale={true}>
      <Card class="h-full hover:shadow-lg transition-shadow">
        <div class="w-12 h-12 bg-athens rounded-lg flex items-center justify-center mb-4">
          <Icon name="tabler:desk" class="w-6 h-6 text-ink" aria-hidden="true" />
        </div>
        <h3 class="text-xl font-semibold text-ink mb-2">Cowork</h3>
        <p class="text-ink-muted">
          A shared workspace for builders, researchers and contributors from the Ethereum and blockchain4good world. Come to focus and work alongside people building similar things.
        </p>
      </Card>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.4} scale={true}>
      <Card class="h-full hover:shadow-lg transition-shadow">
        <div class="w-12 h-12 bg-athens rounded-lg flex items-center justify-center mb-4">
          <Icon name="tabler:users" class="w-6 h-6 text-ink" aria-hidden="true" />
        </div>
        <h3 class="text-xl font-semibold text-ink mb-2">Gather</h3>
        <p class="text-ink-muted">
          Talks, workshops, hacker houses, unconferences and community dinners. Teams and communities from across Web3 keep coming back to meet and build together in a small space, among people who share their values.
        </p>
      </Card>
    </ScrollReveal>
    <ScrollReveal client:idle delay={0.5} scale={true}>
      <Card class="h-full hover:shadow-lg transition-shadow">
        <div class="w-12 h-12 bg-athens rounded-lg flex items-center justify-center mb-4">
          <Icon name="tabler:heart-handshake" class="w-6 h-6 text-ink" aria-hidden="true" />
        </div>
        <h3 class="text-xl font-semibold text-ink mb-2">Connect</h3>
        <p class="text-ink-muted">
          The real value of Giveth House is the people. Over 500 visitors from across the Web3 world have passed through, and many friendships, collaborations and projects that started here kept growing long after they left.
        </p>
      </Card>
    </ScrollReveal>
  </div>
</section>
