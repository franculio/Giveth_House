---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import ScrollReveal from "./ScrollReveal.tsx";
import giveth from "../assets/logos/giveth.svg";
import dappnode from "../assets/logos/dappnode.png";
import blossom from "../assets/logos/blossom.svg";
import akasha from "../assets/logos/akasha.png";
import refibcn from "../assets/logos/refibcn.png";
import hubsnetwork from "../assets/logos/hubsnetwork.svg";
import vocdoni from "../assets/logos/vocdoni.svg";
import thedao from "../assets/logos/thedao.svg";

const projects = [
  { name: "Giveth", url: "https://giveth.io", logo: giveth, height: 30 },
  { name: "Dappnode", url: "https://dappnode.com", logo: dappnode, height: 32 },
  { name: "Blossom Labs", url: "https://blossom.software", logo: blossom, height: 32 },
  { name: "Akasha Hub", url: "https://akasha.barcelona", logo: akasha, height: 40 },
  { name: "ReFi Barcelona", url: "https://www.refibcn.cat", logo: refibcn, height: 32, showName: true },
  { name: "Hubs Network", url: "https://www.hubsnetwork.org", logo: hubsnetwork, height: 24 },
  { name: "Vocdoni", url: "https://vocdoni.io/es/", logo: vocdoni, height: 24 },
  { name: "The DAO Fund", url: "https://thedao.fund", logo: thedao, height: 36, showName: true },
];
// Logos are shown at this multiple of the base heights listed above, so they stay in
// proportion to each other.
const SCALE = 1.43;

// The row is a carousel that slides sideways by itself. The list is drawn twice, one
// right after the other, and the track moves by exactly one copy, so the loop has no jump.
// The second copy is only there for the loop: it is hidden from screen readers and from the keyboard.
const copies = [false, true];
---

<Section tone="white" pad="sm" wall={false}>
  <div class="py-4 md:py-6">
    <ScrollReveal client:idle delay={0.1}>
      <p class="text-xs font-semibold uppercase tracking-widest text-ink text-center mb-4">
        Part of the community
      </p>
      <div class="logo-carousel">
        <div class="logo-track">
          {copies.map((isCopy) => (
            <ul
              class:list={["logo-list", isCopy && "logo-copy"]}
              aria-hidden={isCopy ? "true" : undefined}
            >
              {projects.map((project) => (
                <li>
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${project.name} (opens in new tab)`}
                    tabindex={isCopy ? "-1" : undefined}
                    class="flex items-center gap-2 min-h-11 transition-transform duration-300 hover:-translate-y-0.5 focus-visible:-translate-y-0.5"
                  >
                    <Image
                      src={project.logo}
                      alt={project.showName ? "" : project.name}
                      height={Math.round(project.height * SCALE * 2)}
                      format={project.logo.format === "svg" ? undefined : "webp"}
                      quality={90}
                      class="w-auto"
                      style={`height: ${Math.round(project.height * SCALE)}px`}
                      loading="eager"
                    />
                    {project.showName && (
                      <span class="text-sm font-semibold text-ink whitespace-nowrap">{project.name}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </ScrollReveal>
  </div>
</Section>

<style>
  .logo-carousel {
    overflow: hidden;
    /* Soft edges so the logos fade in and out instead of being cut */
    -webkit-mask-image: linear-gradient(to right, transparent, #000 2rem, #000 calc(100% - 2rem), transparent);
    mask-image: linear-gradient(to right, transparent, #000 2rem, #000 calc(100% - 2rem), transparent);
  }
  .logo-track {
    display: flex;
    width: max-content;
    animation: logo-slide 45s linear infinite;
  }
  .logo-list {
    display: flex;
    flex: none;
    align-items: center;
    gap: 2.5rem;
    /* The same space as the gap, so the two copies are spaced like neighbours */
    padding-right: 2.5rem;
  }
  @media (min-width: 768px) {
    .logo-list {
      gap: 3.5rem;
      padding-right: 3.5rem;
    }
  }
  /* The carousel stops while someone is pointing at it or tabbing through it */
  .logo-carousel:hover .logo-track,
  .logo-carousel:focus-within .logo-track {
    animation-play-state: paused;
  }
  @keyframes logo-slide {
    to {
      transform: translateX(-50%);
    }
  }
  /* With reduced motion nothing moves: one copy of the list, scrollable sideways */
  @media (prefers-reduced-motion: reduce) {
    .logo-carousel {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .logo-track {
      animation: none;
    }
    .logo-copy {
      display: none;
    }
  }
</style>
