---
import { Image } from "astro:assets";
import ScrollReveal from "./ScrollReveal.tsx";
import giveth from "../assets/logos/giveth.svg";
import dappnode from "../assets/logos/dappnode.png";
import blossom from "../assets/logos/blossom.svg";
import akasha from "../assets/logos/akasha.png";
import refibcn from "../assets/logos/refibcn.png";
import hubsnetwork from "../assets/logos/hubsnetwork.svg";
import vocdoni from "../assets/logos/vocdoni.svg";
import thedao from "../assets/logos/thedao.svg";

const projects = [
  { name: "Giveth", url: "https://giveth.io", logo: giveth, height: 30 },
  { name: "Dappnode", url: "https://dappnode.com", logo: dappnode, height: 32 },
  { name: "Blossom Labs", url: "https://blossom.software", logo: blossom, height: 32 },
  { name: "Akasha Hub", url: "https://akasha.barcelona", logo: akasha, height: 40 },
  { name: "ReFi Barcelona", url: "https://www.refibcn.cat", logo: refibcn, height: 32, showName: true },
  { name: "Hubs Network", url: "https://www.hubsnetwork.org", logo: hubsnetwork, height: 24 },
  { name: "Vocdoni", url: "https://vocdoni.io/es/", logo: vocdoni, height: 24 },
  { name: "The DAO Fund", url: "https://thedao.fund", logo: thedao, height: 36, showName: true },
];
---

<section class="border-y border-athens bg-bone py-10 px-4">
  <div class="max-w-3xl mx-auto">
    <ScrollReveal client:idle delay={0.1}>
      <p class="text-xs font-semibold uppercase tracking-widest text-ink-muted text-center mb-8">
        Part of the community
      </p>
      <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6 md:gap-x-14">
        {projects.map((project) => (
          <li>
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${project.name} (opens in new tab)`}
              class="flex items-center gap-2 transition-transform duration-300 hover:-translate-y-0.5 focus-visible:-translate-y-0.5"
            >
              <Image
                src={project.logo}
                alt={project.showName ? "" : project.name}
                height={project.height * 2}
                format={project.logo.format === "svg" ? undefined : "webp"}
                quality={90}
                class="w-auto"
                style={`height: ${project.height}px`}
                loading="lazy"
              />
              {project.showName && (
                <span class="text-sm font-semibold text-ink">{project.name}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </ScrollReveal>
  </div>
</section>
