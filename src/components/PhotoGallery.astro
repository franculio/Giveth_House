---
import { Image } from "astro:assets";
import ScrollReveal from "./ScrollReveal.tsx";
import salonNormal from "../assets/images/salon_normal.jpg";
import terraza1 from "../assets/images/Terraza_1.png";
import bunkerEvento from "../assets/images/bunker_evento.jpg";
import sofaConGente from "../assets/images/Sofa_con_gente.jpg";
import salonReunion1 from "../assets/images/salon_reunion_1.jpg";
import terraza2 from "../assets/images/Terraza_2.jpg";

const photos = [
  { src: salonNormal, alt: "Living room at Giveth House" },
  { src: terraza1, alt: "Rooftop terrace at Giveth House" },
  { src: bunkerEvento, alt: "Community event in the basement" },
  { src: sofaConGente, alt: "People at Giveth House" },
  { src: salonReunion1, alt: "Coworking session at Giveth House" },
  { src: terraza2, alt: "Terrace view at Giveth House" },
];
---

<section class="max-w-6xl mx-auto px-4 py-12 md:py-20">
  <ScrollReveal client:idle delay={0.1}>
    <h2 class="text-4xl font-bold text-gray-900 text-center mb-4">The Space</h2>
    <p class="text-center text-gray-500 mb-10 max-w-xl mx-auto">
      A home, a workspace, a terrace — in the heart of Barcelona's Sants neighbourhood.
    </p>
  </ScrollReveal>

  <ScrollReveal client:idle delay={0.2}>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      {photos.map((photo) => (
        <div class="aspect-square overflow-hidden rounded-lg bg-gray-100">
          <Image
            src={photo.src}
            alt={photo.alt}
            width={600}
            height={600}
            format="webp"
            quality={75}
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </ScrollReveal>
</section>
