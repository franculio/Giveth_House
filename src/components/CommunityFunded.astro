---
import ScrollReveal from "./ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
import Button from "./Button.astro";
---

<section data-dark class="bg-ink text-white py-12 md:py-20 px-4">
  <div class="max-w-4xl mx-auto">

    <ScrollReveal client:idle delay={0.1}>
      <p class="text-xs font-semibold uppercase tracking-widest text-lavender-300 mb-4">
        Community Funded
      </p>
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-6 leading-tight">
        No tickets. No membership fees.<br class="hidden md:block" /> Just generosity.
      </h2>
      <p class="text-botticelli text-lg max-w-2xl mb-10">
        Giveth House has no fixed price for staying. Guests are invited to contribute what feels right after their visit, through the Giveth donation platform. You can give in crypto, on almost any chain. The house has run this way since 2017.
      </p>
    </ScrollReveal>

    <ScrollReveal client:idle delay={0.3}>
      <div class="flex flex-col sm:flex-row gap-4">
        <Button href="/donate" variant="on-dark">
          Donate on Giveth
        </Button>
        <Button href="/support#other-ways" variant="on-dark-outline">
          Other ways to support
        </Button>
      </div>
    </ScrollReveal>

  </div>
</section>
