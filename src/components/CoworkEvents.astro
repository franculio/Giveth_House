---
import { Image } from "astro:assets";
import ScrollReveal from "./ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
import bunkerEvento from "../assets/images/bunker_evento.jpg";

const events = [
  "ETHBarcelona / ETHBCN and ETHCC side gatherings",
  "Devconnect",
  "Giveth retreats",
  "DAppNode offsite",
  "Commons Stack retreat",
  "Curve Labs team retreat",
  "ReClaim hackathon",
  "COSMOS Hacker House",
  "ETHGathering",
  "Holo Hack, Vocdoni and dOrg retreats",
  "Community dinners, including a yearly Christmas dinner",
];
import Button from "./Button.astro";
import Chip from "./Chip.astro";
---

<section class="max-w-6xl mx-auto px-4 py-12 md:py-20">
  <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-start">

    <ScrollReveal client:idle delay={0.1}>
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-ink-muted mb-4">
          Coworking
        </p>
        <h2 class="text-3xl md:text-4xl font-bold text-ink mb-4">
          Cowork with us
        </h2>
        <p class="text-ink-muted mb-4">
          Working remotely on something open source, web3, ReFi or public goods? Come work from
          the house for the day. Desks, good company and people building similar things, in a home
          rather than an office.
        </p>
        <p class="text-ink-muted mb-8">
          Like everything here, there's no fee: contribute what feels right.
        </p>
        <Button href={SITE.houseTelegram}>
          Ask about coworking
        </Button>
      </div>
    </ScrollReveal>

    <ScrollReveal client:idle delay={0.2}>
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-ink-muted mb-4">
          Events
        </p>
        <h2 class="text-3xl md:text-4xl font-bold text-ink mb-4">
          Host something here
        </h2>
        <div class="aspect-video overflow-hidden rounded-xl bg-athens mb-6">
          <Image
            src={bunkerEvento}
            alt="A community event in the basement at Giveth House"
            width={800}
            height={450}
            format="webp"
            quality={75}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>
        <p class="text-ink-muted mb-4">
          The basement and common areas work well for talks, workshops, small hacker houses,
          retreats and community dinners. Over the years the house has hosted:
        </p>
        <ul class="flex flex-wrap gap-2 mb-6">
          {events.map((event) => (
            <Chip as="li">{event}</Chip>
          ))}
        </ul>
        <p class="text-ink-muted mb-8">
          Fun fact: the Token Engineering Commons launched its bonding-curve economy from the
          house kitchen.
        </p>
        <Button href={SITE.houseTelegram} variant="secondary">
          Propose an event
        </Button>
      </div>
    </ScrollReveal>

  </div>
</section>
