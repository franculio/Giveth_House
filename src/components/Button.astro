---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "on-dark" | "on-dark-outline";
  size?: "md" | "lg";
  class?: string;
  [key: string]: unknown;
}

const { href, variant = "primary", size = "md", class: extra = "", ...rest } = Astro.props;

const external = /^https?:\/\//.test(href);

const variants = {
  primary: "bg-grape text-white border-transparent hover:bg-grape-dark",
  secondary: "bg-white text-ink border-ink hover:bg-ink hover:text-white",
  "on-dark": "bg-white text-ink border-transparent hover:bg-athens",
  "on-dark-outline": "bg-transparent text-white border-white hover:bg-white hover:text-ink",
};

const sizes = {
  md: "min-h-11 px-6 py-2.5 text-sm",
  lg: "min-h-12 px-8 py-3 text-base",
};
---

<a
  href={href}
  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
  class:list={[
    "inline-flex items-center justify-center rounded-lg border-2 font-semibold transition-colors",
    variants[variant],
    sizes[size],
    extra,
  ]}
  {...rest}
>
  <slot />
</a>
