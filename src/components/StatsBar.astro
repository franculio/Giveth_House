---
import ScrollReveal from "./ScrollReveal.tsx";
import Section from "./Section.astro";

const stats = [
  { figure: "500+", label: "visitors from Web3" },
  { figure: "7,500+", label: "guest-nights hosted" },
  { figure: "9+", label: "years in Barcelona" },
];
---

<!--
  Three lavender cards of the same width as the blocks above them, touching the
  dark one. They sit side by side separated only by the thick ink line, with the
  same stroke on the sides and below; the top edge is the dark block itself.
  The figure and its text are centred in each card. On phones they stack.
-->
<Section tone="white" pad="none" wall={false}>
  <div class="grid sm:grid-cols-3 gap-[var(--stroke)] bg-ink border-x-[length:var(--stroke)] border-b-[length:var(--stroke)] border-ink">
    {stats.map((s, i) => (
      <ScrollReveal client:idle delay={0.1 + i * 0.1} className="min-w-0">
        <div class="bg-lavender-300 text-ink text-center px-4 py-8 md:py-10 h-full flex flex-col items-center justify-center">
          <p class="text-4xl md:text-5xl lg:text-6xl font-bold leading-none">{s.figure}</p>
          <p class="text-sm md:text-base mt-3">{s.label}</p>
        </div>
      </ScrollReveal>
    ))}
  </div>
</Section>
