---
import Section from "./Section.astro";
import ScrollReveal from "./ScrollReveal.tsx";
import { SITE } from "../config/site.mjs";
---

<Section tone="white" pad="md-tight" wall={false}>
  <ScrollReveal client:idle delay={0.1}>
    <h2 class="display-title text-ink leading-[0.95] mb-8 md:mb-10">How it Works</h2>
  </ScrollReveal>

  <div class="grid cols-photo-grid gap-8">
    <ScrollReveal client:idle delay={0.2} scale={true}>
      <div class="md:pr-8">
        <div class="w-12 h-12 bg-dandelion text-ink border-[length:var(--stroke)] border-ink flex items-center justify-center text-xl font-bold mb-4">1</div>
        <h3 class="text-xl font-semibold text-ink mb-2">Message us on Telegram</h3>
        <p class="text-ink-muted text-sm">
          Write to <a href={SITE.houseTelegram} target="_blank" rel="noopener noreferrer" class="underline hover:text-grape-dark text-grape">{SITE.houseHandle}</a>
          {" "}with who you are, your dates and what brings you here.
        </p>
      </div>
    </ScrollReveal>

    <ScrollReveal client:idle delay={0.3} scale={true}>
      <div class="md:pr-8">
        <div class="w-12 h-12 bg-lavender-300 text-ink border-[length:var(--stroke)] border-ink flex items-center justify-center text-xl font-bold mb-4">2</div>
        <h3 class="text-xl font-semibold text-ink mb-2">Get approved</h3>
        <p class="text-ink-muted text-sm">
          Franco replies personally, based on availability and fit with the space.
        </p>
      </div>
    </ScrollReveal>

    <ScrollReveal client:idle delay={0.4} scale={true}>
      <div class="md:pr-8">
        <div class="w-12 h-12 bg-aquamarine text-ink border-[length:var(--stroke)] border-ink flex items-center justify-center text-xl font-bold mb-4">3</div>
        <h3 class="text-xl font-semibold text-ink mb-2">Stay & contribute</h3>
        <p class="text-ink-muted text-sm">
          Join the community and give back through
          {" "}<a href="/donate" class="underline hover:text-grape-dark text-grape">Giveth</a>, in whatever way feels right.
        </p>
      </div>
    </ScrollReveal>
  </div>
</Section>
