---
import { Icon } from "astro-icon/components";
---

<header
  class="w-full py-2 px-4 border-b border-athens bg-white sticky top-0 z-50"
  role="banner"
>
  <nav
    class="max-w-6xl mx-auto flex items-center justify-between"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="block text-black hover:text-ink transition-colors"
      aria-label="Giveth House - Home"
    >
      <Icon name="giveth-house-logo-compact" class="h-12 w-auto" aria-hidden="true" />
    </a>
    
    <button
      type="button"
      class="md:hidden p-2 text-ink hover:text-grape focus:outline-none focus:ring-2 focus:ring-grape focus:ring-offset-2 rounded-lg"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      id="mobile-menu-button"
    >
      <Icon name="tabler:menu-2" class="w-6 h-6" aria-hidden="true" />
    </button>

    <ul class="hidden md:flex items-center gap-6" role="list">
      <li>
        <a
          href="/about"
          class="text-ink hover:text-grape transition-colors"
          aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}
        >
          About
        </a>
      </li>
      <li>
        <a
          href="/visit"
          class="text-ink hover:text-grape transition-colors"
          aria-current={Astro.url.pathname === '/visit' ? 'page' : undefined}
        >
          Visit
        </a>
      </li>
      <li>
        <a
          href="/faqs"
          class="text-ink hover:text-grape transition-colors"
          aria-current={Astro.url.pathname === '/faqs' ? 'page' : undefined}
        >
          FAQs
        </a>
      </li>
      <li>
        <a
          href="/support"
          class="text-ink hover:text-grape transition-colors"
          aria-current={Astro.url.pathname === '/support' ? 'page' : undefined}
        >
          Support
        </a>
      </li>
      <li>
        <a
          href="https://t.me/Giveth_House"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 bg-grape text-white rounded-lg hover:bg-grape-dark transition-colors"
        >
          Write to us
        </a>
      </li>
    </ul>
  </nav>

  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-athens bg-white"
    role="menu"
    aria-labelledby="mobile-menu-button"
  >
    <ul class="flex flex-col py-4" role="list">
      <li>
        <a
          href="/about"
          class="block px-4 py-3 text-ink hover:bg-bone hover:text-grape transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}
        >
          About
        </a>
      </li>
      <li>
        <a
          href="/visit"
          class="block px-4 py-3 text-ink hover:bg-bone hover:text-grape transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === '/visit' ? 'page' : undefined}
        >
          Visit
        </a>
      </li>
      <li>
        <a
          href="/faqs"
          class="block px-4 py-3 text-ink hover:bg-bone hover:text-grape transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === '/faqs' ? 'page' : undefined}
        >
          FAQs
        </a>
      </li>
      <li>
        <a
          href="/support"
          class="block px-4 py-3 text-ink hover:bg-bone hover:text-grape transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === '/support' ? 'page' : undefined}
        >
          Support
        </a>
      </li>
      <li>
        <a
          href="https://t.me/Giveth_House"
          target="_blank"
          rel="noopener noreferrer"
          class="block px-4 py-3 font-medium text-ink hover:bg-bone transition-colors"
          role="menuitem"
        >
          Write to us on Telegram
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (
        !menuButton.contains(e.target as Node) &&
        !mobileMenu.contains(e.target as Node) &&
        !mobileMenu.classList.contains('hidden')
      ) {
        menuButton.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        menuButton.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
        menuButton.focus();
      }
    });
  }
</script>