---
interface Props {
  as?: string;
  class?: string;
  [key: string]: unknown;
}

const { as: Tag = "span", class: extra = "", ...rest } = Astro.props;
---

<Tag
  class:list={["inline-flex items-center rounded-full bg-athens px-3 py-1.5 text-sm font-medium text-ink", extra]}
  {...rest}
>
  <slot />
</Tag>
