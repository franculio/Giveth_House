---
import Section from "./Section.astro";
import ScrollReveal from "./ScrollReveal.tsx";
import Button from "./Button.astro";
import { SITE } from "../config/site.mjs";

// The three ways the house is offered. Each one is a fixed block of text with
// the colour of its theme (house, community, projects). The idea they all share, a contribution to keep the house
// going, is said once, in the strip stuck underneath.
const offers = [
  {
    title: "Stay with us",
    text: "A bed in a home, not a hotel, for people building in Web3, ReFi and public goods.",
    cta: "Come and stay",
    bg: "bg-dandelion text-ink",
    textColor: "",
    button: "primary",
    dark: false,
  },
  {
    title: "Cowork with us",
    text: "Desks, good company and people building similar things.",
    cta: "Ask about coworking",
    bg: "bg-lavender-300 text-ink",
    textColor: "",
    button: "primary",
    dark: false,
  },
  {
    title: "Host an event",
    text: "Talks, workshops and retreats, in a home with room for people to meet.",
    cta: "Propose an event",
    bg: "bg-aquamarine text-ink",
    textColor: "",
    button: "primary",
    dark: false,
  },
] as const;
---

<!--
  Three blocks in a row and a strip stuck under them, all sharing walls and the
  same width as the blocks below. No white space between them.
-->
<Section tone="white" pad="none" wall={false}>
  <div class="trio">
    {offers.map((o, i) => (
      <ScrollReveal client:idle className="trio-item" delay={i * 0.12} direction="up" distance={40}>
        <div
          data-dark={o.dark || undefined}
          class:list={["w-full h-full p-6 md:p-8 flex flex-col justify-between gap-8", o.bg]}
        >
          <div>
            <h2 class="font-display font-bold leading-[1.02] mb-4" style="font-size: clamp(2rem, 3.4vw, 3.25rem);">
              {o.title}
            </h2>
            <p class:list={["text-[17px]", o.textColor]}>{o.text}</p>
          </div>
          <div>
            <Button href={SITE.houseTelegram} variant={o.button} size="lg" class="whitespace-nowrap">{o.cta}</Button>
          </div>
        </div>
      </ScrollReveal>
    ))}
  </div>

  <!-- The negative margin makes the top stroke of the strip sit exactly on the bottom stroke of the three blocks: one shared wall -->
  <ScrollReveal client:idle delay={0.4}>
    <div class="-mt-[var(--stroke)] border-[length:var(--stroke)] border-ink bg-tulip text-ink px-6 py-6 md:px-8 md:py-8 flex flex-col md:flex-row md:items-baseline gap-2 md:gap-8">
      <p class="font-display font-bold leading-none shrink-0" style="font-size: clamp(1.5rem, 2.4vw, 2.25rem);">In return</p>
      <p class="text-2xl leading-snug">
        Everything here is kept going by contributions. It doesn't have to be money, but money is welcome.
      </p>
    </div>
  </ScrollReveal>
</Section>
