---
import FooterContent from "./FooterContent.astro";

interface Props {
  /**
   * When true the footer is a block of the same width as the blocks above it
   * (used on the About page). By default it is the full-width band the other
   * pages use.
   */
  block?: boolean;
}

const { block = false } = Astro.props;
---

{
  block ? (
    <footer id="contact" class="bg-white" role="contentinfo">
      <!-- No white above: on the About page the footer continues the blue block above it -->
      <div class="max-w-6xl mx-auto px-4 pb-4 md:pb-8">
        <div data-dark class="bg-ink text-botticelli px-6 py-10 md:px-12 md:py-14">
          <FooterContent />
        </div>
      </div>
    </footer>
  ) : (
    <footer
      id="contact"
      data-dark
      class="w-full py-12 px-4 bg-ink text-botticelli"
      role="contentinfo"
    >
      <div class="max-w-6xl mx-auto">
        <FooterContent />
      </div>
    </footer>
  )
}
