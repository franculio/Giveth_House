---
import { Icon } from "astro-icon/components";
---

<footer
  id="contact"
  class="w-full py-12 px-4 border-t border-athens bg-white"
  role="contentinfo"
>
  <div class="max-w-6xl mx-auto">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <h2 class="text-lg font-semibold text-ink mb-4">Giveth House</h2>
        <p class="text-ink-muted">
          A community-driven Web3 hub in Barcelona — a shared home,
          coworking space, and gathering place for builders and communities.
        </p>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-ink mb-4">Links</h2>
        <ul class="space-y-2">
          <li>
            <a href="/about" class="text-ink hover:text-grape transition-colors">About</a>
          </li>
          <li>
            <a href="/visit" class="text-ink hover:text-grape transition-colors">Visit</a>
          </li>
          <li>
            <a href="/faqs" class="text-ink hover:text-grape transition-colors">FAQs</a>
          </li>
          <li>
            <a href="/support" class="text-ink hover:text-grape transition-colors">Support</a>
          </li>
          <li>
            <a href="/donate" class="text-ink hover:text-grape transition-colors">Donate</a>
          </li>
        </ul>
      </div>
      <div>
        <h2 class="text-lg font-semibold text-ink mb-4">Connect</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="https://x.com/GivethHouse"
              class="flex items-center gap-2 text-ink hover:text-grape transition-colors"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Follow Giveth House on X (opens in new tab)"
            >
              <Icon name="tabler:brand-x" class="w-5 h-5" aria-hidden="true" />
              <span>X</span>
            </a>
          </li>
          <li>
            <a
              href="https://t.me/Giveth_House"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-ink hover:text-grape transition-colors"
            >
              <Icon name="tabler:brand-telegram" class="w-5 h-5" aria-hidden="true" />
              <span>Telegram</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="pt-8 border-t border-athens flex flex-col sm:flex-row items-center justify-between gap-3 text-ink-muted text-sm">
      <p>&copy; {new Date().getFullYear()} Giveth House. Open source · MIT License.</p>
      <a
        href="https://www.hubsnetwork.org/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-athens bg-bone text-ink-muted hover:border-ink hover:text-ink hover:bg-white transition-all text-xs font-medium"
        aria-label="Giveth House is part of the Hubs Network (opens in new tab)"
      >
        <Icon name="tabler:hexagons" class="w-3.5 h-3.5" aria-hidden="true" />
        Part of the Hubs Network
      </a>
    </div>
  </div>
</footer>
